<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Sync Call History > Record calls. The service reads no screen content; it exists
     so Android allows microphone recording while the phone's dialer is on screen. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="1000"
    android:canRetrieveWindowContent="false"
    android:description="@string/call_recorder_accessibility_description" />
