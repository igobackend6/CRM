# Copy this file to env/.env.development, env/.env.staging, env/.env.production
# and fill in real values for each environment. Never commit the filled-in files.
#
# SUPABASE_ANON_KEY is the public/anon key — safe for a client app.
# The service-role key must NEVER appear in this file or anywhere in mobile/.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
API_BASE_URL=http://localhost:8000
