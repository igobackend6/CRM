# Copy to deploy/.env on the server and fill in real values. Never commit .env.
#
# The address the app will use (no https://, no path). Either a domain you own that points at the
# server's IP (an "A" record), or, with no domain, <server-ip-with-dashes>.sslip.io
# e.g. server 203.0.113.10  ->  203-0-113-10.sslip.io
DOMAIN=api.example.com

# --- Backend settings (same names as backend/.env.example) ---------------------------------
# Production turns off /docs and /openapi.json. docker-compose.yml already sets it; kept for clarity.
ENVIRONMENT=production
LOG_LEVEL=INFO

SUPABASE_URL=https://your-project.supabase.co
# Privileged key: lives ONLY on the server, never in the app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Optional (leave blank until configured)
AI_PROVIDER=
AI_PROVIDER_API_KEY=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
INTERNAL_WEBHOOK_SECRET=
