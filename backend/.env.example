# Copy to .env and fill in real values. Never commit .env.
#
# SUPABASE_SERVICE_ROLE_KEY is privileged — it must only ever exist here,
# never in the Flutter app or any client-side code.

ENVIRONMENT=development
LOG_LEVEL=INFO

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Phase 20 — AI Call Insights. Left unset: no AI provider is configured
# or usable in this repository. Leaving these blank makes
# services/ai/provider.get_ai_provider() return None, which the AI
# pipeline treats as "unavailable" rather than fabricating a result.
# Do not fill these in without configuring (and paying for) a real
# provider account — this project never invents credentials.
AI_PROVIDER=
AI_PROVIDER_API_KEY=

# Phase 4 — FCM push on lead assignment. Left unset: no Firebase project
# is configured for this repository. Unset = services/push/service.py
# no-ops and only the in-app notification (notifications table + Realtime
# badge) fires. To enable: create a Firebase project, download a service
# account key with the Firebase Cloud Messaging API scope.
#   FCM_PROJECT_ID           the Firebase project id
#   FCM_SERVICE_ACCOUNT_JSON path to the key file, OR the JSON inline
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# Shared secret for the Supabase Database Webhook that triggers a push
# on notifications INSERT (covers Admin-panel-initiated assignments).
# Unset = POST /internal/push/notification 404s, and the FastAPI backend
# fires the app-path push itself instead. Set this AND configure the
# webhook to have one code path own every assignment push.
INTERNAL_WEBHOOK_SECRET=
